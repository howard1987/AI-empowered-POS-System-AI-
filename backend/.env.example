# 数据库连接（docker compose 起库时 POSTGRES_PASSWORD 与本值需一致；生产请改强口令）
DATABASE_URL=postgres://cashier:cashier123@localhost:5432/cashier
# JWT 密钥：≥32 位随机串（可用 node -e "console.log(require('crypto').randomBytes(32).toString('hex'))" 生成）
# 不配置时后端首启自动生成随机密钥（.runtime/jwt-secret，0600）；示例弱值会被启动校验直接忽略
#JWT_SECRET=
# 服务端口
PORT=3000
