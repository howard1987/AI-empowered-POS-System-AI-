{
  "version": 2,
  "locale": "zh-CN",
  "index_path": "aoci.txt",
  "exclude_dirs": [
    "node_modules",
    "vendor",
    "dist",
    "build",
    "target",
    ".next",
    "coverage",
    "tmp",
    "uploads",
    "backup",
    "backups",
    "artifacts",
    ".output",
    "__pycache__",
    ".venv",
    "venv",
    ".pytest_cache",
    ".mypy_cache",
    ".ruff_cache",
    ".tox",
    ".nox",
    "htmlcov",
    "tts",
    "models",
    "certs",
    "logs",
    ".runtime"
  ],
  "exclude_files": [
    "*.backup.*",
    "*.bak",
    ".coverage"
  ],
  "exclude_exts": [
    ".dll",
    ".exe",
    ".wasm",
    ".onnx",
    ".bin",
    ".pak"
  ],
  "curation_exclude": [],
  "hook_strict": false,
  "ledger_enabled": true,
  "line_ending_tolerance": true,
  "cognition_refresh_threshold": 30,
  "overview_delivery": {
    "chunk_tokens": 8000
  },
  "managed_scope": {
    "version": "managed-scope-policy/v2",
    "profile": "production",
    "observe_change_policy": "review_required",
    "approval_mode": "inherit",
    "approval_thresholds": {
      "entry_removal_count": 25,
      "entry_removal_percent": 25
    },
    "rules": [
      {
        "rule_id": "keep-public-code",
        "action": "index",
        "pattern": "backend/public",
        "pattern_kind": "directory",
        "reason": "管理端/PWA前端源码需保留索引覆盖",
        "source": "user",
        "created_by": "YL",
        "order": 100,
        "enabled": true
      },
      {
        "rule_id": "exclude-signature-images",
        "action": "exclude",
        "pattern": "backend/public/signatures",
        "pattern_kind": "directory",
        "reason": "电子签名图片为用户上传资产，不入代码索引",
        "source": "user",
        "created_by": "YL",
        "order": 101,
        "enabled": true
      },
      {
        "rule_id": "exclude-inventory-raw",
        "action": "exclude",
        "pattern": "inventory_raw.txt",
        "pattern_kind": "file",
        "reason": "仓库根部数据导出文件，不纳入代码索引",
        "source": "user",
        "created_by": "YL",
        "order": 102,
        "enabled": true
      },
      {
        "rule_id": "excl-binary-audio",
        "action": "exclude",
        "pattern": "*.wav",
        "pattern_kind": "glob",
        "reason": "TTS生成的音频片段为服务端产物，无代码语义，不入代码索引",
        "source": "user",
        "created_by": "codebuddy",
        "order": 200,
        "enabled": true
      },
      {
        "rule_id": "excl-binary-image",
        "action": "exclude",
        "pattern": "*.png",
        "pattern_kind": "glob",
        "reason": "截图/图标/启动图为二进制资产，无代码语义",
        "source": "user",
        "created_by": "codebuddy",
        "order": 201,
        "enabled": true
      },
      {
        "rule_id": "excl-binary-photo",
        "action": "exclude",
        "pattern": "*.jpg",
        "pattern_kind": "glob",
        "reason": "AI训练帧与截图为二进制资产，无代码语义",
        "source": "user",
        "created_by": "codebuddy",
        "order": 202,
        "enabled": true
      },
      {
        "rule_id": "excl-binary-jar",
        "action": "exclude",
        "pattern": "*.jar",
        "pattern_kind": "glob",
        "reason": "gradle wrapper二进制，无代码语义",
        "source": "user",
        "created_by": "codebuddy",
        "order": 203,
        "enabled": true
      },
      {
        "rule_id": "excl-binary-xlsx",
        "action": "exclude",
        "pattern": "*.xlsx",
        "pattern_kind": "glob",
        "reason": "测试用例/盘点表等办公文档，无代码语义",
        "source": "user",
        "created_by": "codebuddy",
        "order": 204,
        "enabled": true
      }
    ]
  },
  "cognition_budget": {
    "version": "cognition-budget-policy/v1",
    "mode": "enforce",
    "whole_index": {
      "target_tokens": 200000,
      "warning_tokens": 300000,
      "max_tokens": 400000
    },
    "r": [
      {
        "min_c": 1,
        "max_c": 4,
        "target_tokens": 25,
        "max_tokens": 50
      },
      {
        "min_c": 5,
        "max_c": 7,
        "target_tokens": 45,
        "max_tokens": 90
      },
      {
        "min_c": 8,
        "max_c": 8,
        "target_tokens": 70,
        "max_tokens": 140
      },
      {
        "min_c": 9,
        "max_c": 9,
        "target_tokens": 90,
        "max_tokens": 180
      }
    ],
    "s": [
      {
        "min_c": 1,
        "max_c": 4,
        "target_tokens": 20,
        "max_tokens": 40
      },
      {
        "min_c": 5,
        "max_c": 7,
        "target_tokens": 40,
        "max_tokens": 80
      },
      {
        "min_c": 8,
        "max_c": 8,
        "target_tokens": 70,
        "max_tokens": 140
      },
      {
        "min_c": 9,
        "max_c": 9,
        "target_tokens": 100,
        "max_tokens": 200
      }
    ]
  },
  "installed_agents": [],
  "automation": {
    "mode": "auto"
  },
  "ai": {
    "enabled": false,
    "provider": "openai-compatible",
    "base_url": "",
    "model": "",
    "api_key_env": "",
    "timeout_seconds": 0,
    "max_concurrency": 0,
    "max_input_tokens": 0,
    "token_accounting": "auto",
    "prompt_snapshot": "redacted"
  }
}
