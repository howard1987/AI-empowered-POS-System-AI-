# ═══════════════════════════════════════════════════════════
#  社区超市收银系统 · 服务端配置
#  首次运行：把本文件复制为 .env 再改（start-server.bat 会自动复制一份）
#  改完保存后重新运行 start-server.bat 生效
# ═══════════════════════════════════════════════════════════

# ── 服务端口 ──
# 局域网内收银机/平板访问地址：http://<本机IP>:PORT/pwa/
PORT=3100
# HTTPS 端口（手机扫码/拍照/装 PWA 必需安全上下文，证书随启动自动签发）
HTTPS_PORT=3443

# ── 数据库 ──
# embedded = 内置便携 PostgreSQL（免安装，推荐；数据存 C:\ProgramData\pos-cashier）
# external = 使用外部已安装的 PostgreSQL（须填下面 DATABASE_URL）
PG_MODE=embedded
PG_PORT=54329
PG_PASSWORD=password
# 内嵌库的工作目录（留空则 C:\ProgramData\pos-cashier）。必须是纯 ASCII 路径！
#POS_DATA_DIR=C:\ProgramData\pos-cashier
# 仅 PG_MODE=external 时生效（示例）：
#DATABASE_URL=postgres://postgres:你的密码@127.0.0.1:5432/cashier

# ── 安全 ──
# 登录令牌密钥：>=32 位随机串。留空则首次启动自动生成并写回本文件
# 注意：更换此值会使所有已登录设备的令牌失效，需重新登录
#JWT_SECRET=

# ── 可选：图片/AI 样本目录外置到数据盘或 NAS ──
#AI_UPLOADS_DIR=D:\pos-uploads
