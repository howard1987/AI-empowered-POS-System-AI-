# 数据库连接（docker compose 起库时 POSTGRES_PASSWORD 与本值需一致；生产请改强口令）
# ⚠ P4 安全：缺 DATABASE_URL 后端将拒绝以弱口令默认值启动；务必显式配置
DATABASE_URL=postgres://cashier:cashier123@localhost:5432/cashier
# JWT 密钥：≥32 位随机串（可用 node -e "console.log(require('crypto').randomBytes(32).toString('hex'))" 生成）
# 不配置时后端首启自动生成随机密钥（.runtime/jwt-secret，0600）；示例弱值会被启动校验直接忽略
#JWT_SECRET=
# 服务端口
PORT=3000

# ─── P4 安全加固（按需开启）───
# 绑定网卡：留空=监听全部网卡（LAN 收银兼容）；生产可设 127.0.0.1 或指定内网网卡
#BIND_HOST=127.0.0.1
# HSTS：自签名证书 LAN 部署启用会锁死浏览器，仅在生产可信证书时设 true
#ENABLE_HSTS=true
# 遗留出厂默认口令检测：仅历史库恢复场景临时设为旧默认口令，触发强制改密；平时留空
#LEGACY_DEFAULT_PW=
# 自动训练解释器白名单（逗号分隔绝对路径）：配置后 ai.autotrain.python 仅允许列表内值，否则仅允许 python/python3 或存在的绝对路径
#AI_TRAIN_PYTHON_ALLOWLIST=
# 迁移完整性严格模式：db/migrations.manifest.json 存在时，设 1 则拒绝清单外未知迁移文件（防注入）；默认仅告警
#MIGRATION_STRICT=1

