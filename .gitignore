# ── 依赖与构建产物 ──
node_modules/
backend/dist/
frontend-desktop/dist-modern/
frontend-desktop/dist-win7-build/
dist-electron/
release/

# ── 运行资产（AI/语音模型，另行分发）──
*.onnx
backend/tts/voices/
backend/models/

# ── 上传与运行期数据 ──
backend/public/uploads/
*.log
_pgpw.txt
.env

# ── 根目录临时调试件（体检报告建议归档清理项）──
_*.cjs
_*.mjs
_*.log
_*.out
_*.txt
_watchdog*
runtime-watchdog*

# ── 二进制运行资产 ──
*.exe
backend/tts/piper/

# ── 运行期密钥、证书与调试临时件（勿上传公共仓库）──
backend/certs/
backend/.runtime/
backend/probe-admin-tmp.cjs
backend/.playwright-cli/
backend/.tmpcrawl/

# ── Python 缓存 ──
__pycache__/
*.pyc

# ── 移动端 APK 工程（构建产物与依赖）──
mobile-apk/node_modules/
mobile-apk/android/.gradle/
mobile-apk/android/app/build/
mobile-apk/android/build/
mobile-apk/android/local.properties
mobile-apk/android/.idea/
mobile-apk/dist/

# ── 运行期签名图（用户笔迹数据，勿上传）──
backend/public/signatures/

# ── 内部运维/测试工具（含真实凭据，不入仓库）──
backend/tools/
mobile-apk/tools/sec-verify.mjs

# ── 运行期数据备份（灾备产物，逐店本地生成，不入仓库）──
backend/backups/

# ── TTS 调试/实验页与片段库（服务端生成产物，部署时随 dist 分发）──
backend/public/tts-frag/
backend/public/tts-ab/
backend/public/tts-tn/

# ── 第三方 PG 客户端二进制（64MB，dev 期供 pg_dump/pg_restore 使用；
#    发布包由 deploy/build-all.ps1 从 node_modules/embedded-postgres 生成 pg/bin）──
backend/vendor/
